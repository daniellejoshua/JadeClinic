<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- LocalDB without file attachment - works in Debug and Release -->
		<add name="JadeDentalConnection"
			 connectionString="Server=(localdb)\MSSQLLocalDB;Database=JadeDentalSupply;Integrated Security=true;TrustServerCertificate=True;Persist Security Info=False;"
         providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<!-- Development/Production settings -->
		<add key="IsFirstRun" value="true" />
		<add key="ApplicationMode" value="Development" />
		<add key="DatabaseLocation" value="LocalDB" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>
