<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="JadeDentalConnection"
			 connectionString="Data Source=|DataDirectory|\App_Data\JadeDentalSupply.db;Cache=Shared;"
			 providerName="Microsoft.Data.Sqlite" />
	</connectionStrings>

	<appSettings>
		<add key="NodeRole" value="AdminServer" />
		<add key="AdminMachineName" value="DANIELLE" />
		<add key="IsFirstRun" value="false" />
		<add key="ApplicationMode" value="Production" />
		<add key="DatabaseLocation" value="PostgreSQL" />
		<add key="PgHost" value="localhost" />
		<add key="PgPort" value="5432" />
		<add key="PgDatabase" value="jadeclinic" />
		<add key="PgUser" value="jadeclinic" />
		<add key="PgPassword" value="JadeClinic2026!" />
		<add key="UpdatePath" value="\\192.168.0.100\JadeClinicUpdates" />
		<add key="SupabaseConnectionString" value="" />
		<add key="BackupPath" value="\\192.168.0.100\JadeClinicData\Backups" />
		<add key="ImagesPath" value="\\192.168.0.100\JadeClinicData\Images" />
	</appSettings>
</configuration>
