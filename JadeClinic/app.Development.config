<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- LocalDB for both development and production - consistent everywhere -->
		<add name="JadeDentalConnection"
			 connectionString="Server=(localdb)\MSSQLLocalDB;Database=JadeDentalSupply;Integrated Security=true;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<!-- Development mode settings -->
		<add key="IsFirstRun" value="true" />
		<add key="ApplicationMode" value="Development" />
		<add key="EnvironmentName" value="Development" />
		<!-- Development specific settings -->
		<add key="EnableDebugLogging" value="true" />
		<add key="ShowSQLQueries" value="true" />
		<add key="DatabaseLocation" value="LocalDB" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>